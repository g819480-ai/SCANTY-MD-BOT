
import makeWASocket, {
  useMultiFileAuthState
} from '@whiskeysockets/baileys';

import pino from 'pino';
import path from 'node:path';
import fs from 'node:fs/promises';

const sessions = new Map();
const SESSION_DIR = path.resolve('./private_sessions');

export async function startUserSession(userId, phoneNumber, onPairingCode) {
  if (!/^[a-f0-9-]{16,64}$/i.test(userId)) {
    throw new Error('Invalid user ID');
  }

  if (!/^\d{10,15}$/.test(phoneNumber)) {
    throw new Error('Use digits only, including your country code.');
  }

  if (sessions.has(userId)) {
    throw new Error('This user already has an active session.');
  }

  await fs.mkdir(SESSION_DIR, { recursive: true });

  const folder = path.join(SESSION_DIR, userId);
  const { state, saveCreds } =
    await useMultiFileAuthState(folder);

  if (state.creds.registered) {
    throw new Error('This account is already registered.');
  }

  const sock = makeWASocket({
    auth: state,
    logger: pino({ level: 'silent' }),
    printQRInTerminal: false,
    markOnlineOnConnect: false
  });

  sessions.set(userId, sock);
  sock.ev.on('creds.update', saveCreds);

  sock.ev.on('connection.update', ({ connection }) => {
    if (connection === 'open') {
      console.log(`User connected: ${userId}`);
    }

    if (connection === 'close') {
      sessions.delete(userId);
    }
  });

  try {
    const code = await sock.requestPairingCode(phoneNumber);
    onPairingCode(code);
    return { started: true };
  } catch (error) {
    sessions.delete(userId);
    throw error;
  }
}
