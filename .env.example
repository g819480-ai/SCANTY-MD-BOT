PORT=3000
NODE_ENV=development

# Required for the Render + Neon backend
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisToAStrongPassword123!
SESSION_ENCRYPTION_KEY=replace-with-a-secret-of-at-least-64-characters

# Cloudflare dashboard origin(s). Use a comma-separated list if needed.
DASHBOARD_ORIGIN=https://scanty-md-dashboard.g819480.workers.dev
# Optional: DASHBOARD_ORIGINS=https://example.com,https://staging.example.com

# Never commit real secrets. Copy this file to .env and fill in values.
